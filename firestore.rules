rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------------
    // Helpers
    // ---------------------------------------------------------------
    function signedIn() {
      return request.auth != null;
    }

    function metricKeys() {
      return ['views', 'clicks', 'promptsCopied'];
    }

    function projectPath(projectId) {
      return /databases/$(database)/documents/projects/$(projectId);
    }

    function slugPath(slug) {
      return /databases/$(database)/documents/slugs/$(slug);
    }

    // Estrutura e limites de um projeto (anti-spam / anti-abuso de armazenamento)
    function validProject(data) {
      return data.keys().hasOnly([
          'ownerId', 'name', 'slug', 'pageTitle', 'description', 'status',
          'views', 'clicks', 'promptsCopied', 'createdAt', 'updatedAt',
          'categoryBadge', 'blocks'
        ])
        && data.ownerId is string
        && data.name is string && data.name.size() > 0 && data.name.size() <= 120
        && data.slug is string && data.slug.matches('^[a-z0-9]+(-[a-z0-9]+)*$') && data.slug.size() <= 80
        && data.pageTitle is string && data.pageTitle.size() <= 200
        && data.description is string && data.description.size() <= 2000
        && data.status in ['published', 'draft']
        && data.blocks is list && data.blocks.size() <= 100
        && data.views is int && data.clicks is int && data.promptsCopied is int
        && data.createdAt is string && data.updatedAt is string
        && (!('categoryBadge' in data) || data.categoryBadge is string);
    }

    // O slug pertence a este projeto e a este usuário após a escrita (batch atômico)
    function slugReservedFor(slug, projectId) {
      return existsAfter(slugPath(slug))
        && getAfter(slugPath(slug)).data.projectId == projectId
        && getAfter(slugPath(slug)).data.ownerId == request.auth.uid;
    }

    // Visitante só pode somar +1 em exatamente UMA métrica por escrita
    function isSingleMetricIncrement() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return changed.hasOnly(metricKeys())
        && changed.size() == 1
        && (!changed.hasAny(['views']) || request.resource.data.views == resource.data.views + 1)
        && (!changed.hasAny(['clicks']) || request.resource.data.clicks == resource.data.clicks + 1)
        && (!changed.hasAny(['promptsCopied']) || request.resource.data.promptsCopied == resource.data.promptsCopied + 1);
    }

    // ---------------------------------------------------------------
    // Projetos
    // ---------------------------------------------------------------
    match /projects/{projectId} {

      // LEITURA
      // - Qualquer pessoa lê um projeto PUBLICADO por ID (página pública)
      // - O dono lê os próprios rascunhos
      // - Listagens só do próprio dono (consulta deve filtrar por ownerId)
      allow get: if resource.data.status == 'published'
        || (signedIn() && resource.data.ownerId == request.auth.uid);
      allow list: if signedIn() && resource.data.ownerId == request.auth.uid;

      // CRIAÇÃO: dono = usuário logado, métricas começam zeradas, slug reservado no mesmo batch
      allow create: if signedIn()
        && validProject(request.resource.data)
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.views == 0
        && request.resource.data.clicks == 0
        && request.resource.data.promptsCopied == 0
        && slugReservedFor(request.resource.data.slug, projectId);

      // ATUALIZAÇÃO
      allow update: if (
          // Dono editando conteúdo: não pode trocar dono, data de criação nem métricas
          signedIn()
          && resource.data.ownerId == request.auth.uid
          && validProject(request.resource.data)
          && !request.resource.data.diff(resource.data).affectedKeys()
               .hasAny(['ownerId', 'createdAt', 'views', 'clicks', 'promptsCopied'])
          && (
            !request.resource.data.diff(resource.data).affectedKeys().hasAny(['slug'])
            || slugReservedFor(request.resource.data.slug, projectId)
          )
        ) || (
          // Visitante (ou qualquer um) incrementando métrica de página publicada
          resource.data.status == 'published' && isSingleMetricIncrement()
        );

      // EXCLUSÃO: apenas o dono
      allow delete: if signedIn() && resource.data.ownerId == request.auth.uid;

      // Série temporal diária de métricas: projects/{id}/daily/{AAAA-MM-DD}
      match /daily/{day} {
        allow read: if signedIn()
          && get(projectPath(projectId)).data.ownerId == request.auth.uid;

        allow create: if day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && get(projectPath(projectId)).data.status == 'published'
          && request.resource.data.keys().hasOnly(metricKeys())
          && request.resource.data.keys().size() == 1
          && (!request.resource.data.keys().hasAny(['views']) || request.resource.data.views == 1)
          && (!request.resource.data.keys().hasAny(['clicks']) || request.resource.data.clicks == 1)
          && (!request.resource.data.keys().hasAny(['promptsCopied']) || request.resource.data.promptsCopied == 1);

        allow update: if get(projectPath(projectId)).data.status == 'published'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(metricKeys())
          && request.resource.data.diff(resource.data).affectedKeys().size() == 1
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['views'])
              || request.resource.data.views == resource.data.get('views', 0) + 1)
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['clicks'])
              || request.resource.data.clicks == resource.data.get('clicks', 0) + 1)
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['promptsCopied'])
              || request.resource.data.promptsCopied == resource.data.get('promptsCopied', 0) + 1);

        allow delete: if signedIn()
          && get(projectPath(projectId)).data.ownerId == request.auth.uid;
      }
    }

    // ---------------------------------------------------------------
    // Reserva global de slugs (garante URL pública única)
    // ---------------------------------------------------------------
    match /slugs/{slug} {
      allow get: if true;
      allow list: if false;

      allow create: if signedIn()
        && slug.matches('^[a-z0-9]+(-[a-z0-9]+)*$')
        && slug.size() <= 80
        && request.resource.data.keys().hasOnly(['projectId', 'ownerId'])
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.projectId is string
        // só pode reservar um slug para um projeto próprio gravado no mesmo batch
        && existsAfter(projectPath(request.resource.data.projectId))
        && getAfter(projectPath(request.resource.data.projectId)).data.ownerId == request.auth.uid
        && getAfter(projectPath(request.resource.data.projectId)).data.slug == slug;

      allow update: if false;

      allow delete: if signedIn() && resource.data.ownerId == request.auth.uid;
    }
  }
}
