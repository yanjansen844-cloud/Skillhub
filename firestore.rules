rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Regras de Segurança e Integridade do SkillHub
    match /projects/{projectId} {
      
      // 1. LEITURA:
      // - Visitantes anônimos (Instagram/TikTok) só podem ler projetos PUBLICADOS ('published')
      // - Usuários autenticados (Criadores/Admins) podem ler rascunhos ('draft') e publicados
      allow get, list: if (resource.data.status == 'published') || (request.auth != null);

      // 2. CRIAÇÃO:
      // - Exige autenticação
      // - Validação rígida de tipo e tamanho para evitar spam/abuso de armazenamento
      allow create: if request.auth != null
        && request.resource.data.name is string 
        && request.resource.data.name.size() > 0 
        && request.resource.data.name.size() <= 120
        && request.resource.data.slug is string 
        && request.resource.data.slug.size() > 0 
        && request.resource.data.slug.size() <= 80
        && request.resource.data.status in ['published', 'draft']
        && request.resource.data.blocks is list 
        && request.resource.data.blocks.size() <= 100;

      // 3. EXCLUSÃO:
      // - Exige autenticação
      allow delete: if request.auth != null;

      // 4. ATUALIZAÇÃO:
      // - Opção A: Usuário autenticado pode atualizar o projeto
      // - Opção B: Visitante anônimo pode APENAS incrementar métricas (views, clicks, promptsCopied)
      allow update: if (
        // Criador autenticado
        (request.auth != null)
        ||
        // Visitante público incrementando métricas com segurança
        (
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['views', 'clicks', 'promptsCopied'])
          // Garante que métricas só aumentem de 1 em 1 e nunca diminuam ou recebam valores arbitrários
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['views']) 
              || request.resource.data.views == resource.data.views + 1)
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['clicks']) 
              || request.resource.data.clicks == resource.data.clicks + 1)
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['promptsCopied']) 
              || request.resource.data.promptsCopied == resource.data.promptsCopied + 1)
        )
      );
    }
  }
}
